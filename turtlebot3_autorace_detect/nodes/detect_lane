# ── Post-circle lane-stability ───────────────────────────────────────────────
# Maximum deviation (px) from last_center_x that a new pair must satisfy.
# Increase if the robot hesitates / freezes after the circle.
# Decrease if it still jumps to the adjacent lane.
POST_CIRCLE_MAX_CENTER_DELTA   = 110.0   # was 90 in previous version

# Frames of the *same* different pair needed before we commit to switching.
POST_CIRCLE_SWITCH_FRAMES      = 28

# How much extra weight the continuity term gets in scoring (>1 = sticky).
POST_CIRCLE_CONTINUITY_BIAS    = 5.0

# Additive penalty (px equivalent) when candidate center drifts from current.
POST_CIRCLE_CENTER_SHIFT_PENALTY = 500.0

# ── Post-circle turn counting ────────────────────────────────────────────────
# How many distinct turning segments must be counted before the final-straight
# / parking logic arms.  Set to 1 if there is only one clear turn between the
# circle exit and the parking road.  Raise to 2 or 3 if there are more.
POST_CIRCLE_REQUIRED_TURN_SEGMENTS = 2   # TUNE THIS for your physical track

# ── Parking lot ──────────────────────────────────────────────────────────────
# Consecutive frames of a very-straight pair needed to enter parking mode.
PARKING_PAIR_REQUIRED      = 8

# Pair heading (px) below which the road counts as "straight" (parking road).
PARKING_STRAIGHT_HEADING_MAX = 35.0

# Pair heading (px) above which we declare the parking-lot exit turn started.
PARKING_EXIT_HEADING_MIN   = 45.0

# ── Final straight (post-parking finish approach) ────────────────────────────
# Consecutive good-pair frames needed to EXIT final-straight-hold mode.
# Raised from 3 to avoid premature exits during the parking lot passage.
FINAL_STRAIGHT_CONFIRM_FRAMES = 8

# -- Optional parking white-dash override ------------------------------------
# Disabled by default via ~use_white_lane_detection=False. Keep these values
# only for lab/debug runs where white dashed guides are intentionally used.
PARKING_WHITE_MIN_COMPONENT_AREA = 90
PARKING_WHITE_MIN_COMPONENT_HEIGHT = 18
PARKING_WHITE_MAX_COMPONENT_WIDTH = 130
