PARKING_WHITE_MAX_PAIR_WIDTH_DELTA = 130.0
PARKING_WHITE_LOST_HOLD_FRAMES = 3

# -- Final left turn and finish stop -----------------------------------------
# After the robot passes the parking road, the CD map requires a
# left turn into the red full-stop rectangle instead of stopping in parking.
FINAL_LEFT_MIN_HEADING = 38.0
FINAL_LEFT_FAR_TARGET_OFFSET = 210.0
