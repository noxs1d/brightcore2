#!/usr/bin/env python3

import os
import threading

import cv2
import numpy as np
import rospy
import yaml
from cv_bridge import CvBridge, CvBridgeError
from geometry_msgs.msg import Twist
from sensor_msgs.msg import CompressedImage, Image
from std_msgs.msg import Bool, Float32


class LaneFollower:

    def __init__(self):
        rospy.init_node('lane_follower', anonymous=False)
        rospy.loginfo("=== Lane Follower hybrid scanline ===")

        self.bridge = CvBridge()
        self._load_params()
        self._load_calibration(rospy.get_param(
            '~calibration_file',
            os.path.join(os.path.dirname(__file__),
                         '../calibration/camera_calibration.yaml')))

        self.error_prev = 0.0
        self.pid_error_prev = 0.0
        self.error_integral = 0.0
        self.error_smooth = 0.0
        self.last_time = rospy.Time.now()

        self.last_left_cx = None
        self.last_right_cx = None
        self.last_scanline_left = {}
        self.last_scanline_right = {}
        self.last_lane_center = None
        self.last_lane_source = 'INIT'
        self.active_lane_source = 'INIT'
        self.lost_frames = 0
        self.frame_count = 0
        self.processed_frame_count = 0
        self.drive_enabled = rospy.get_param('~enabled', True)
        self.start_time = rospy.Time.now()
        self.finish_detected_frames = 0
        self.finished = False
        self.finish_logged = False
        self._latest_lock = threading.Lock()
        self._latest_msg = None
        self._latest_is_compressed = True
        self._dropped_pending_frames = 0
        self._last_debug_pub_time = rospy.Time(0)

        self.cmd_pub = rospy.Publisher('/cmd_vel', Twist, queue_size=1)
        self.error_pub = rospy.Publisher('/lane_error', Float32, queue_size=1)
        if self.debug_bird:
            self.bird_pub = rospy.Publisher('/lane/bird_eye', Image, queue_size=1)
        if self.debug_perspective:
            self.perspective_pub = rospy.Publisher('/lane/perspective_overlay', Image, queue_size=1)
        if self.debug_mask:
            self.mask_pub = rospy.Publisher('/lane/yellow_mask', Image, queue_size=1)
        if self.debug_white_mask:
            self.white_mask_pub = rospy.Publisher('/lane/white_mask', Image, queue_size=1)
        if self.finish_enabled and self.debug_mask:
            self.red_mask_pub = rospy.Publisher('/lane/red_mask', Image, queue_size=1)
        if self.debug_img:
            self.debug_pub = rospy.Publisher('/lane/debug_image', Image, queue_size=1)

        self.use_compressed = rospy.get_param('~use_compressed', True)
        self._latest_is_compressed = self.use_compressed
        self.image_topic = rospy.get_param('~camera_topic', '/camera/image')
        self.compressed_topic = rospy.get_param(
            '~camera_compressed_topic', self.image_topic + '/compressed')

        if self.use_compressed:
            self.image_sub = rospy.Subscriber(
                self.compressed_topic, CompressedImage, self._image_cb,
                queue_size=1, buff_size=2**24, tcp_nodelay=True)
            rospy.loginfo(f"Subscribing to {self.compressed_topic}")
        else:
            self.image_sub = rospy.Subscriber(
                self.image_topic, Image, self._image_cb_raw,
                queue_size=1, buff_size=2**24, tcp_nodelay=True)
            rospy.loginfo(f"Subscribing to {self.image_topic}")

        self.enable_sub = rospy.Subscriber(
            '/lane_following/enable', Bool, self._enable_cb, queue_size=1)
        rospy.on_shutdown(self._shutdown)
        self._no_frame_start = rospy.Time.now()
        self._no_frame_warned = False
        rospy.loginfo(
            f"Ready. Waiting for camera frames... processing_rate={self.processing_rate:.1f}Hz")

