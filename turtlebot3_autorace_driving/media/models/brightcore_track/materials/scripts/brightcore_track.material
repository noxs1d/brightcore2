material brightcore_track/road
{
  receive_shadows on
  technique
  {
    pass
    {
      ambient 0.7 0.7 0.7 1.0
      diffuse 1.0 1.0 1.0 1.0
      specular 0.05 0.05 0.05 1.0 1.0

      texture_unit
      {
        texture brightcore_track.png
        filtering trilinear
        scale 1 1
      }
    }
  }
}
