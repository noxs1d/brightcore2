<launch>
  <!-- ============================================================
       BRIGHTCORE2: All-in-one on the Pi (localhost).
       raspicam_node → scanline lane follower → /cmd_vel
       No intrinsic/extrinsic pipeline needed.
       ============================================================ -->

  <!-- ==================== 1. CAMERA (raspicam_node) ==================== -->
  <node pkg="raspicam_node" type="raspicam_node" name="raspicam_node" output="screen">
    <param name="camera_info_url" value="package://raspicam_node/camera_info/camerav2_410x308.yaml"/>
    <param name="width" value="410"/>
    <param name="height" value="308"/>
    <param name="framerate" value="30"/>
    <param name="enable_raw" value="false"/>
    <param name="enable_imv" value="false"/>
    <param name="camera_frame_id" value="raspicam"/>
    <param name="vflip" value="true"/>
    <param name="hflip" value="true"/>
  </node>

  <!-- ==================== 2. SCANLINE LANE FOLLOWER ==================== -->
  <node pkg="turtlebot3_autorace_driving" type="lane_follower_scanline"
        name="lane_follower_scanline" output="screen">
    <rosparam file="$(find turtlebot3_autorace_driving)/param/lane_follower_scanline.yaml" command="load"/>
    <param name="use_compressed" value="true"/>
    <param name="enabled" value="true"/>
    <param name="camera_topic" value="/raspicam_node/image"/>
    <param name="camera_compressed_topic" value="/raspicam_node/image/compressed"/>
    <param name="calibration_file"
           value="$(find turtlebot3_autorace_driving)/calibration/camera_calibration.yaml"/>
    <param name="performance/processing_rate" value="15.0"/>
    <param name="debug/publish_bird_eye" value="false"/>
    <param name="debug/publish_perspective_overlay" value="false"/>
    <param name="debug/publish_debug" value="false"/>
    <param name="debug/publish_mask" value="false"/>
    <param name="debug/publish_white_mask" value="false"/>
  </node>
</launch>
